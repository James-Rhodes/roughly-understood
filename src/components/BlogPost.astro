---
import Tags from "../components/Tags.astro";
let { url, title, description, pubDate, tags } = Astro.props;
const pubDateString = new Date(pubDate);
pubDate = pubDateString.toDateString();
---

<div class="border-2 border-solid border-gray-200 p-1 px-5 my-3">
    <a href={url}>
        <h3>{title}</h3>
    </a>
    <div class="flex flex-wrap gap-x-5">
        <div>{pubDate}</div>
        <div>
            <Tags tags={tags} inLine />
        </div>
    </div>
    <div class="mt-5">
        <p>{description}</p>
    </div>
    <a href={url} class="read-more inline-block p-2 rounded-xl mb-1">
        Read more
    </a>
</div>

<style>
    a {
        color: unset;
    }
    h3 {
        margin-bottom: 0;
    }

    .read-more {
        background: #1f7a8c;
        color: white;
        text-decoration: none;
        transition: background-color 0.15s ease;
    }

    .read-more:hover {
        background: #176271;
        text-decoration: none;
    }
</style>
