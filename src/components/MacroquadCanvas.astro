---
let { id, src, alt } = Astro.props;
---

<!-- `src` points at a folder inside src/assets/macroquad, e.g.
     "foray-into-fourier/adding-sines", holding a Macroquad-produced
     mq_js_bundle.js together with its .wasm file. -->
<mquad-canvas load data-id={id} data-src={src}>
    <canvas
        id={id}
        width="366"
        height="206"
        tabindex="0"
        data-raw-handle="1"
        aria-label={alt}
    >
    </canvas>
</mquad-canvas>

<script>
    // Bundles are imported lazily through Vite so they get bundled, hashed and
    // served like any other module instead of being fetched from public/.
    const bundles = import.meta.glob("../assets/macroquad/**/*.js");
    const wasmFiles = import.meta.glob("../assets/macroquad/**/*.wasm", {
        query: "?url",
        import: "default",
        eager: true,
    });

    const findFile = (files, dir, extension) =>
        Object.entries(files).find(
            ([path]) => path.startsWith(`${dir}/`) && path.endsWith(extension),
        )?.[1];

    class MacroquadCanvas extends HTMLElement {
        constructor() {
            super();

            (async () => {
                const dir = `../assets/macroquad/${this.dataset.src.replace(/\/$/, "")}`;
                const loadBundle = findFile(bundles, dir, ".js");
                const wasmUrl = findFile(wasmFiles, dir, ".wasm");

                if (!loadBundle || !wasmUrl) {
                    console.error(
                        `MacroquadCanvas: no bundle or wasm found for "${this.dataset.src}"`,
                    );
                    return;
                }

                const lib = await loadBundle();
                lib.load(wasmUrl);
            })();
        }
    }

    customElements.define("mquad-canvas", MacroquadCanvas);
</script>

<style>
    canvas {
        color: #ececec;
        color-scheme: dark;
        font-family: "Fira Sans", sans-serif;
        font-size: 0.875rem;
        --rem: 16;
        --header-height: 60px;
        --scroll-padding-top: calc(var(--header-height) + 16px);
        --container-padding: 8px;
        box-sizing: border-box;
        -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
        outline: none;
        width: 100% !important;
        height: auto !important;
        border-radius: 10px;
        background: #2b2c2f;
        min-width: 180px;
        min-height: 120px;
        cursor: auto;
        aspect-ratio: 1.77778 / 1;
    }
</style>
