---
let { id, src, alt } = Astro.props;
---

<!-- `src` points at a folder inside src/assets/macroquad, e.g.
     "foray-into-fourier/adding-sines", holding the animation's .wasm file.
     The shared mq_js_bundle.js lives in the root of that folder and drives
     every canvas on the site. -->
<mquad-canvas load data-id={id} data-src={src}>
    <canvas
        id={id}
        width="366"
        height="206"
        tabindex="0"
        data-raw-handle="1"
        aria-label={alt}
    >
    </canvas>
</mquad-canvas>

<script>
    // One shared bundle serves every canvas: each load() call creates its own
    // independent instance (WebGL context, wasm memory and event handlers),
    // so only the wasm has to be resolved per animation.
    import { load } from "../assets/macroquad/mq_js_bundle.js";

    const wasmFiles = import.meta.glob("../assets/macroquad/**/*.wasm", {
        query: "?url",
        import: "default",
        eager: true,
    });

    // How far outside the viewport a canvas may be before it starts loading.
    const PRELOAD_MARGIN = "400px 0px";

    class MacroquadCanvas extends HTMLElement {
        constructor() {
            super();

            const dir = `../assets/macroquad/${this.dataset.src.replace(/\/$/, "")}`;
            const wasmUrl = Object.entries(wasmFiles).find(([path]) =>
                path.startsWith(`${dir}/`),
            )?.[1];

            if (!wasmUrl) {
                console.error(
                    `MacroquadCanvas: no wasm found for "${this.dataset.src}"`,
                );
                return;
            }

            const start = () => load(wasmUrl, this.dataset.id);

            // Compiling the wasm and creating the WebGL context is the
            // expensive part, so wait until the canvas is (nearly) on screen.
            if (typeof IntersectionObserver === "undefined") {
                start();
                return;
            }

            const observer = new IntersectionObserver(
                (entries, observer) => {
                    if (!entries.some((entry) => entry.isIntersecting)) return;
                    observer.disconnect();
                    start();
                },
                { rootMargin: PRELOAD_MARGIN },
            );
            observer.observe(this);
        }
    }

    customElements.define("mquad-canvas", MacroquadCanvas);
</script>

<style>
    canvas {
        color: #ececec;
        color-scheme: dark;
        font-family: "Fira Sans", sans-serif;
        font-size: 0.875rem;
        --rem: 16;
        --header-height: 60px;
        --scroll-padding-top: calc(var(--header-height) + 16px);
        --container-padding: 8px;
        box-sizing: border-box;
        -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
        outline: none;
        width: 100% !important;
        height: auto !important;
        border-radius: 10px;
        background: #2b2c2f;
        min-width: 180px;
        min-height: 120px;
        cursor: auto;
        aspect-ratio: 1.77778 / 1;
    }
</style>
