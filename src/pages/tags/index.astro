---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Tags from "../../components/Tags.astro";
import { getPosts } from "../../utils/posts";
const tags = [...new Set(getPosts().flatMap((post) => post.frontmatter.tags))];
const pageTitle = "All Tags";
---

<BaseLayout
	pageTitle={pageTitle}
	titleMargin
	description="A list of all of the tags used in articles written on Roughly Understood."
>
	<Tags tags={tags} />
</BaseLayout>
